@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap');
:root{font-family:'DM Sans',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;color:#33262b;background:#fff8f7;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;font-optical-sizing:auto;font-weight:400;--pink:#e85d83;--deep:#c8446a;--muted:#947a83;--line:#f1dce2}
*{box-sizing:border-box}body{margin:0;min-width:320px;min-height:100vh;background:radial-gradient(ellipse at 12% 3%,#ffe0e9 0,transparent 32%),radial-gradient(ellipse at 94% 22%,#fff0d9 0,transparent 27%),#fff8f7}button,input,textarea{font:inherit}button{ -webkit-tap-highlight-color:transparent}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #e85d8360;outline-offset:2px}.app-shell{width:min(100%,520px);margin:auto;padding:23px 18px 35px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:8px}.brand{display:flex;align-items:center;gap:9px;text-decoration:none;color:#33262b;font-size:12px;font-weight:800;letter-spacing:.9px}.brand-icon{width:38px;height:38px;display:grid;place-items:center;background:#fff;border:1px solid #f8e7eb;border-radius:14px;font-size:22px;box-shadow:0 5px 20px #e99cb51a}.mode-chip{display:flex;align-items:center;gap:6px;padding:7px 9px;background:#fff9;border:1px solid #f5e4e8;border-radius:99px;font-size:10px;font-weight:700;color:#947a83;white-space:nowrap}.mode-chip.cloud{color:#317c59;background:#f1fbf4;border-color:#d8f0df}.status-dot{width:6px;height:6px;background:#e9a0b4;border-radius:50%}.cloud .status-dot{background:#4caf7a}.hero{text-align:center;padding:33px 0 13px}.eyebrow{display:flex;align-items:center;justify-content:center;gap:6px;font-size:10px;letter-spacing:1.7px;color:var(--pink);font-weight:800}.hero h1{font-family:'Playfair Display',Georgia,serif;font-size:clamp(34px,8.5vw,46px);line-height:1.09;letter-spacing:-1.3px;margin:13px 0 12px;font-weight:700}.hero h1 em{color:#d95179;font-weight:600}.hero>p{margin:0 auto;max-width:330px;color:var(--muted);font-size:13px;line-height:1.65}.flower-stage{height:175px;display:grid;place-items:center;position:relative;isolation:isolate}.halo{position:absolute;width:160px;height:130px;border-radius:50%;background:#ffb6cb65;filter:blur(28px);z-index:-1}.hero-flower{font-size:102px;filter:drop-shadow(0 12px 9px #b75a6b20);animation:float 3s ease-in-out infinite;line-height:1;transform-origin:center}.spark{position:absolute;color:#e98aa5;font-size:21px;animation:twinkle 2.2s ease-in-out infinite}.spark-one{top:21px;left:24%}.spark-two{top:45px;right:20%;animation-delay:.6s}.spark-three{bottom:18px;right:29%;animation-delay:1.1s}.floating-heart{position:absolute;bottom:31px;left:27%;color:#e985a2;animation:float 3.5s ease-in-out infinite}.panel{background:#ffffffdf;border:1px solid #f5dce3;border-radius:25px;padding:18px;box-shadow:0 14px 45px #9e5c6d0c;backdrop-filter:blur(10px)}.tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:#fff0f3;padding:4px;border-radius:15px;margin-bottom:21px}.tab{border:0;border-radius:12px;padding:12px 5px;background:transparent;font-weight:700;color:#997984;font-size:12px;display:flex;justify-content:center;align-items:center;gap:7px;cursor:pointer;transition:background .2s,color .2s,box-shadow .2s}.tab.active{background:#fff;color:#c8446a;box-shadow:0 3px 12px #bd66751a}.section-label{display:flex;align-items:center;gap:9px;margin:0 0 11px;color:#d66d89;font-size:10px;letter-spacing:1.4px;font-weight:800}.section-label span{color:#49353d;font-size:13px;letter-spacing:0}.flower-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.flower-option{position:relative;min-width:0;border:1px solid var(--line);border-radius:16px;padding:10px 3px 11px;background:#fff;cursor:pointer;color:#33262b;display:flex;flex-direction:column;align-items:center;gap:3px;transition:transform .16s,border-color .16s,background .16s,box-shadow .16s}.flower-option:hover{transform:translateY(-2px);border-color:#edb5c5}.flower-option:active{transform:scale(.97)}.flower-option.selected{border:1.5px solid var(--pink);background:#fff4f7;box-shadow:0 4px 14px #e85d8318}.flower-emoji{font-size:34px;line-height:1.25;margin-bottom:3px}.flower-option strong{font-size:11px;font-weight:800}.flower-option small{font-size:10px;color:var(--muted)}.check-mark{position:absolute;right:5px;top:5px;width:16px;height:16px;border-radius:50%;display:grid;place-items:center;background:var(--pink);color:white}.field-label{display:block;margin:17px 0 8px;font-size:11px;font-weight:800;color:#5a424b}input,textarea{display:block;width:100%;border:1px solid #ecd7de;background:#fff;border-radius:13px;padding:13px 14px;font-size:13px;color:#33262b;outline:none;transition:border-color .2s,box-shadow .2s}input::placeholder,textarea::placeholder{color:#b9a4ab}input:focus,textarea:focus{border-color:var(--pink);box-shadow:0 0 0 3px #e85d8314}textarea{resize:vertical;min-height:83px;line-height:1.5}.counter{text-align:right;color:#b39aa3;font-size:10px;margin-top:5px}.primary{width:100%;border:0;border-radius:14px;padding:14px 13px;margin-top:17px;background:linear-gradient(135deg,#ed7294,#d94c78);color:#fff;font-weight:800;font-size:13px;box-shadow:0 8px 18px #e85d832b;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:transform .15s,filter .15s,opacity .15s}.primary:hover:not(:disabled){filter:brightness(1.035);transform:translateY(-1px)}.primary:active:not(:disabled){transform:scale(.99)}.primary:disabled{opacity:.6;cursor:wait}.helper{font-size:10px;color:#a18a92;line-height:1.6;margin:10px 2px 0;text-align:center}.error{font-size:12px;line-height:1.5;color:#a83355;background:#fff0f3;border:1px solid #f3cbd7;border-radius:11px;padding:10px 12px;margin-top:12px;overflow-wrap:anywhere}.open-intro{text-align:center;padding:8px 0 14px}.letter-icon{font-size:37px}.open-intro h2,.created-card h2,.gift-reveal h2{font-family:'Playfair Display',Georgia,serif;font-size:25px;margin:8px 0;color:#38272e}.open-intro p{font-size:12px;color:var(--muted);margin:0}.code-input{text-align:center;font-size:23px!important;font-weight:800;letter-spacing:6px;text-transform:uppercase;padding:15px!important}.gift-reveal,.created-card{position:relative;text-align:center;overflow:hidden;margin-top:19px;padding:21px 14px 16px;border:1px solid #f3d3dd;border-radius:19px;background:linear-gradient(180deg,#fff8fa,#fff);animation:reveal .6s ease both}.gift-reveal:before,.created-card:before{content:"";position:absolute;inset:0 0 auto;height:4px;background:linear-gradient(90deg,#f8c5d2,#e85d83,#f7d9a7)}.revealed-flower,.created-flower{font-size:74px;margin:8px 0 12px;animation:flowerIn .75s cubic-bezier(.2,.8,.2,1) both}.gift-message{font-family:'Playfair Display',Georgia,serif;font-size:18px;line-height:1.55;color:#684a55;white-space:pre-wrap;overflow-wrap:anywhere;margin:15px 0}.gift-from{font-size:11px;color:#a18a92}.gift-from strong{color:#694653}.heart-row{color:#e87896;font-size:19px;margin-top:16px}.confetti{color:#e9a0b4;letter-spacing:8px;font-size:16px}.created-card{margin-top:22px;padding:24px 15px 17px}.success-icon{width:34px;height:34px;border-radius:50%;background:#e8f7ed;color:#379363;display:grid;place-items:center;margin:0 auto 13px}.created-card .helper{max-width:280px;margin:0 auto}.code-display{font-size:30px;letter-spacing:6px;font-weight:800;background:#fff0f4;border:1px dashed #e985a2;border-radius:14px;padding:14px 7px;margin:17px 0 0;color:#bd3e65}.text-button{border:0;background:transparent;color:#bc4b6c;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:7px;margin:15px auto 0;padding:7px;cursor:pointer}.text-button svg{transform:rotate(180deg)}footer{display:flex;justify-content:center;align-items:center;gap:6px;color:#b49ca4;font-size:10px;margin:20px 0 0}footer svg{color:#d78aa0}@keyframes float{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-8px) rotate(2deg)}}@keyframes twinkle{0%,100%{opacity:.35;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}@keyframes reveal{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}@keyframes flowerIn{0%{opacity:0;transform:scale(.5) rotate(-15deg)}70%{opacity:1;transform:scale(1.08) rotate(4deg)}100%{transform:scale(1) rotate(0)}}@media(min-width:600px){.app-shell{padding-top:28px}.hero{padding-top:39px}.panel{padding:22px}.flower-stage{height:185px}}@media(max-width:370px){.app-shell{padding-left:12px;padding-right:12px}.panel{padding:14px}.flower-option strong{font-size:10px}.tab{font-size:11px}.flower-emoji{font-size:31px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
